[Unit]
Description=rx: check NRCan and GEM-15 elevation data and rebuild the Shilo DEM if new
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=rx
Group=rx
WorkingDirectory=/opt/rx
EnvironmentFile=/etc/rx.env
ExecStart=/opt/rx/.venv/bin/python dem_sync.py
Nice=10
